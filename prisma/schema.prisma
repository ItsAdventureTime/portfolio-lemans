// Prisma schema for Le Mans Operations & Job Cost Management System

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x", "linux-arm64-openssl-3.0.x", "linux-arm64-openssl-1.1.x", "darwin-arm64"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Project roles (mirrored in src/lib/roles.ts)
enum ProjectRole {
  ROLE_SALES
  ROLE_SVC
  ROLE_PURCH
  ROLE_GM
  ROLE_DCS
  ROLE_ADMIN
}

// Auth tables required by Better Auth with Prisma adapter
model User {
  id            String      @id
  name          String
  email         String      @unique
  emailVerified Boolean     @default(false)
  image         String?
  role          ProjectRole @default(ROLE_SALES)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  sessions      Session[]
  accounts      Account[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Domain enums
enum SQStatus {
  DRAFT
  APPROVED
  CONVERTED
  REJECTED
}

enum JOStatus {
  DRAFT
  APPROVED
  IN_PROGRESS
  PARTS_PENDING
  COMPLETED
  BILLED
  CLOSED
}

enum ItemType {
  LABOR
  PARTS
  MISC
}

enum PRStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CONVERTED_TO_PO
}

enum POStatus {
  DRAFT
  SENT
  PARTIAL
  RECEIVED
  CLOSED
}

enum SIStatus {
  DRAFT
  ALLOCATED
  APPROVED
  PAID
  CANCELLED
}

enum OpexStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  DISBURSED
}

enum DisbursementStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

enum ServiceInvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  CANCELLED
}

// Domain models
model Customer {
  id             String           @id @default(uuid())
  customerNo     String           @unique
  name           String
  tin            String?
  address        String?
  phone          String?
  email          String?
  vehicles       Vehicle[]
  quotations     SalesQuotation[]
  jobOrders      JobOrder[]
  serviceInvoices ServiceInvoice[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model Vehicle {
  id          String           @id @default(uuid())
  customerId  String
  customer    Customer         @relation(fields: [customerId], references: [id])
  plateNo     String           @unique
  vinChassis  String?
  engineNo    String?
  makeModel   String
  year        String?
  color       String?
  odometer    Int?
  quotations  SalesQuotation[]
  jobOrders   JobOrder[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model SalesQuotation {
  id          String               @id @default(uuid())
  quoteNo     String               @unique
  customerId  String
  customer    Customer             @relation(fields: [customerId], references: [id])
  vehicleId   String
  vehicle     Vehicle              @relation(fields: [vehicleId], references: [id])
  advisor     String
  totalLabor  Float                @default(0)
  totalParts  Float                @default(0)
  netTotal    Float                @default(0)
  status      SQStatus             @default(DRAFT)
  items       SalesQuotationItem[]
  jobOrders   JobOrder[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model SalesQuotationItem {
  id          String         @id @default(uuid())
  quoteId     String
  quote       SalesQuotation @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  itemType    ItemType
  description String
  quantity    Float          @default(1)
  unitPrice   Float          @default(0)
  discount    Float          @default(0)
  netAmount   Float          @default(0)
}

model JobOrder {
  id                  String                    @id @default(uuid())
  joNo                String                    @unique
  sqId                String?
  sq                  SalesQuotation?           @relation(fields: [sqId], references: [id])
  customerId          String
  customer            Customer                  @relation(fields: [customerId], references: [id])
  vehicleId           String
  vehicle             Vehicle                   @relation(fields: [vehicleId], references: [id])
  advisor             String
  technician          String?
  cubeTopperNo        String?
  status              JOStatus                  @default(IN_PROGRESS)
  totalEstimatedLabor Float                     @default(0)
  totalEstimatedParts Float                     @default(0)
  actualLaborCost     Float                     @default(0)
  actualPartsCost     Float                     @default(0)
  billedAmount        Float                     @default(0)
  netProfit           Float                     @default(0)
  items               JobOrderItem[]
  events              JobOrderEvent[]
  purchaseRequests    PurchaseRequest[]
  serviceInvoice      ServiceInvoice?
  invoiceAllocations  SupplierInvoiceAllocation[]
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
}

model JobOrderItem {
  id          String   @id @default(uuid())
  joId        String
  jo          JobOrder @relation(fields: [joId], references: [id], onDelete: Cascade)
  itemType    ItemType
  description String
  quantity    Float    @default(1)
  unitPrice   Float    @default(0)
  discount    Float    @default(0)
  netAmount   Float    @default(0)
}

model JobOrderEvent {
  id          String   @id @default(uuid())
  joId        String
  jo          JobOrder @relation(fields: [joId], references: [id], onDelete: Cascade)
  eventType   String
  description String
  createdById String?
  createdAt   DateTime @default(now())
}

model Attachment {
  id          String   @id @default(uuid())
  entityType  String
  entityId    String
  fileName    String
  contentType String
  size        Int
  storageKey  String   @unique
  uploadedById String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
}

model PurchaseRequest {
  id            String              @id @default(uuid())
  prNo          String              @unique
  joId          String?
  jo            JobOrder?             @relation(fields: [joId], references: [id])
  status        PRStatus            @default(DRAFT)
  requestedById String
  requestedAt   DateTime            @default(now())
  approvedById  String?
  approvedAt    DateTime?
  notes         String?
  items         PurchaseRequestItem[]
  purchaseOrder PurchaseOrder?
}

model PurchaseRequestItem {
  id          String          @id @default(uuid())
  prId        String
  pr          PurchaseRequest @relation(fields: [prId], references: [id], onDelete: Cascade)
  description String
  quantity    Float           @default(1)
  unitCost    Float           @default(0)
  total       Float           @default(0)
}

model PurchaseOrder {
  id          String           @id @default(uuid())
  poNo        String           @unique
  prId        String?          @unique
  pr          PurchaseRequest? @relation(fields: [prId], references: [id])
  status      POStatus         @default(DRAFT)
  supplier    String?
  total       Float            @default(0)
  orderedAt   DateTime?
  receivedAt  DateTime?
  notes       String?
  items       PurchaseOrderItem[]
  invoices    SupplierInvoice[]
}

model PurchaseOrderItem {
  id          String        @id @default(uuid())
  poId        String
  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  description String
  quantity    Float         @default(1)
  unitCost    Float         @default(0)
  total       Float         @default(0)
  receivedQty Float         @default(0)
}

model SupplierInvoice {
  id          String                    @id @default(uuid())
  siNo        String                    @unique
  poId        String?
  po          PurchaseOrder?            @relation(fields: [poId], references: [id])
  supplier    String?
  invoiceDate DateTime?
  dueDate     DateTime?
  totalAmount Float                     @default(0)
  status      SIStatus                  @default(DRAFT)
  notes       String?
  allocations SupplierInvoiceAllocation[]
  disbursement Disbursement?
}

model SupplierInvoiceAllocation {
  id          String          @id @default(uuid())
  siId        String
  si          SupplierInvoice @relation(fields: [siId], references: [id], onDelete: Cascade)
  joId        String
  jo          JobOrder        @relation(fields: [joId], references: [id])
  amount      Float           @default(0)
  description String?
  createdAt   DateTime        @default(now())
}

model OpexRequest {
  id            String     @id @default(uuid())
  requestNo     String     @unique
  category      String
  description   String
  amount        Float      @default(0)
  requestedById String
  status        OpexStatus @default(DRAFT)
  requestedAt   DateTime   @default(now())
  approvedById  String?
  approvedAt    DateTime?
  notes         String?
  disbursement  Disbursement?
}

model Disbursement {
  id                 String             @id @default(uuid())
  disbursementNo     String             @unique
  opexRequestId      String?            @unique
  opexRequest        OpexRequest?       @relation(fields: [opexRequestId], references: [id])
  supplierInvoiceId  String?            @unique
  supplierInvoice    SupplierInvoice?   @relation(fields: [supplierInvoiceId], references: [id])
  amount             Float              @default(0)
  status             DisbursementStatus @default(PENDING)
  paymentMethod      String?
  referenceNo        String?
  paidAt             DateTime?
  proofAttachmentKey String?
  recordedById       String
  createdAt          DateTime           @default(now())
}

model ServiceInvoice {
  id          String               @id @default(uuid())
  invoiceNo   String               @unique
  joId        String?              @unique
  jo          JobOrder?            @relation(fields: [joId], references: [id])
  customerId  String
  customer    Customer             @relation(fields: [customerId], references: [id])
  issueDate   DateTime             @default(now())
  subtotal    Float                @default(0)
  vatAmount   Float                @default(0)
  total       Float                @default(0)
  amountPaid  Float                @default(0)
  status      ServiceInvoiceStatus @default(DRAFT)
  dueDate     DateTime?
  notes       String?
  payments    Payment[]
}

model Payment {
  id               String         @id @default(uuid())
  serviceInvoiceId String
  serviceInvoice   ServiceInvoice @relation(fields: [serviceInvoiceId], references: [id], onDelete: Cascade)
  amount           Float          @default(0)
  paymentMethod    String
  referenceNo      String?
  paidAt           DateTime       @default(now())
  recordedById     String
}
