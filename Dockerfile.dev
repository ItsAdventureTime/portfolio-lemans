FROM node:20-alpine3.20 AS dev
# Install openssl for Prisma engine detection; libssl symlink guards against
# Alpine 3.21+ moving libssl.so.3 to /usr/lib.
RUN apk add --no-cache openssl && \
    ln -s /usr/lib/libssl.so.3 /lib/libssl.so.3 2>/dev/null || true

WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

COPY package.json package-lock.json* ./
RUN npm install

COPY . .
RUN npx prisma generate

EXPOSE 3000

CMD ["npm", "run", "dev"]
