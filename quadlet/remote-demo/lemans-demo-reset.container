[Unit]
Description=Le Mans remote demo reset job

[Container]
Image=docker.io/library/lemans-bridge-dashboard-go:demo-go
ContainerName=lemans-demo-reset
Network=lemans-demo.network
Environment=DEMO_MODE=true
Environment=LISTEN_ADDR=:8080
Environment=PGHOST=lemans-demo-db
Environment=PGUSER=postgres
Environment=PGDATABASE=lemans_demo_db
EnvironmentFile=%h/.config/containers/systemd/bridge-ph/lemans-demo/lemans-demo.env
Secret=db_password,type=env,target=PGPASSWORD
Exec=/usr/local/bin/reset-demo.sh

[Service]
Type=oneshot
RemainAfterExit=no
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
