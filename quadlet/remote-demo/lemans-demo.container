[Unit]
Description=Le Mans remote demo application
After=lemans-remote-demo-db.service

[Container]
Image=docker.io/library/lemans-bridge-dashboard:latest-alpine
ContainerName=lemans-remote-demo-app
Network=lemans-remote-demo-net
PublishPort=127.0.0.1:3002:3000
Environment=NODE_ENV=production
EnvironmentFile=%h/.config/containers/systemd/bridge-ph/lemans-demo/lemans-demo.env

[Service]
Restart=always

[Install]
WantedBy=default.target
