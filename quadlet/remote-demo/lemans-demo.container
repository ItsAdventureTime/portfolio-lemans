[Unit]
Description=Le Mans remote demo Next.js web application
After=lemans-demo-go.service
Requires=lemans-demo-go.service

[Container]
Image=docker.io/library/lemans-bridge-dashboard:demo-web
ContainerName=lemans-demo-app
Network=caddy.network
Network=lemans-demo.network
PublishPort=127.0.0.1:3002:3000
Environment=NODE_ENV=production
Environment=NEXT_PUBLIC_BASE_PATH=/demo/lemans
Environment=API_BASE_URL=http://lemans-demo-go:8080

[Service]
Restart=always

[Install]
WantedBy=default.target
