[Unit]
Description=Le Mans remote demo PostgreSQL

[Container]
Image=docker.io/library/postgres:alpine
ContainerName=lemans-remote-demo-db
Network=lemans-remote-demo-net
Environment=POSTGRES_USER=postgres
Environment=POSTGRES_PASSWORD_FILE=/run/secrets/db_password
Environment=POSTGRES_DB=lemans_remote_demo_db
Volume=lemans-remote-demo-db-data:/var/lib/postgresql

[Service]
Restart=always

[Install]
WantedBy=default.target
