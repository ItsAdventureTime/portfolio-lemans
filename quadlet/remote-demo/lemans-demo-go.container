[Unit]
Description=Le Mans remote demo Go API backend
After=lemans-demo-db.service
Requires=lemans-demo-db.service

[Container]
Image=docker.io/library/lemans-bridge-dashboard-go:demo-go
ContainerName=lemans-demo-go
Network=lemans-demo.network
Environment=NODE_ENV=production
Environment=LISTEN_ADDR=:8080
Environment=DEMO_MODE=true
Environment=B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
Environment=B2_REGION=us-west-004
Environment=B2_BUCKET_NAME=bridge-ph
Environment=B2_KEY_PREFIX=lemans/demo
# The deployment adds release-specific DATABASE_URL and B2 credential values
# as Environment= entries before the [Service] section.

[Service]
Restart=always

[Install]
WantedBy=default.target
