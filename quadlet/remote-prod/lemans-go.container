[Unit]
Description=Le Mans remote production Go API backend
After=lemans-prod-db.service
Requires=lemans-prod-db.service

[Container]
Image=docker.io/library/lemans-bridge-dashboard-go:prod-go
ContainerName=lemans-prod-go
Network=lemans.network
Environment=NODE_ENV=production
Environment=LISTEN_ADDR=:8080
Environment=DEMO_MODE=false
Environment=B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
Environment=B2_REGION=us-west-004
Environment=B2_BUCKET_NAME=lemans-prod-attachments
# The deployment adds release-specific DATABASE_URL and B2 credential values
# as Environment= entries before the [Service] section.

[Service]
Restart=always

[Install]
WantedBy=default.target
