[Unit]
Description=Le Mans production Caddy bridge container
After=caddy.service

[Container]
Image=docker.io/library/caddy:2-alpine
ContainerName=lemans-prod-caddy-bridge
Network=caddy.network
Network=lemans-remote-prod-net
Exec=sleep infinity

[Service]
Restart=always

[Install]
WantedBy=default.target
