[Unit]
Description=Le Mans remote production application
After=lemans-remote-prod-db.service

[Container]
Image=lemans-bridge-dashboard:lts-slim
ContainerName=lemans-remote-prod-app
Network=lemans-remote-prod-net
PublishPort=127.0.0.1:3003:3000
Environment=NODE_ENV=production
Environment=DATABASE_URL=postgresql://postgres:postgres_remote_prod_pass@lemans-remote-prod-db:5432/lemans_remote_prod_db?schema=public
Environment=BETTER_AUTH_SECRET={{ BetterAuthSecret }}
Environment=BETTER_AUTH_URL=http://127.0.0.1:3003
Environment=B2_ENDPOINT={{ B2Endpoint }}
Environment=B2_REGION={{ B2Region }}
Environment=B2_ACCESS_KEY_ID={{ B2AccessKeyId }}
Environment=B2_SECRET_ACCESS_KEY={{ B2SecretAccessKey }}
Environment=B2_BUCKET_NAME=lemans-remote-prod-attachments
SecurityLabelDisable=true
NoNewPrivileges=true
DropCapability=ALL

[Service]
Restart=always

[Install]
WantedBy=default.target
