{
  "name": "lemans-bridge-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "ts-node --compiler-options '{\"module\":\"commonjs\"}' -r ./src/__tests__/setup.ts -r tsconfig-paths/register src/__tests__/index.ts",
    "db:push": "prisma db push",
    "db:seed": "ts-node -P tsconfig.seed.json prisma/seed.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev"
  },
  "prisma": {
    "seed": "ts-node -P tsconfig.seed.json prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "@prisma/client": "^5.19.0",
    "better-auth": "^1.6.26",
    "clsx": "^2.1.1",
    "lucide-react": "^0.439.0",
    "next": "^14.2.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.5.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.8",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.8",
    "postcss": "^8.4.41",
    "prettier": "^3.3.3",
    "prisma": "^5.19.0",
    "tailwindcss": "^3.4.10",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4"
  }
}
