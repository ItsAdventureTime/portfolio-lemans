# BEGIN LEMANS PROD ROUTE
# Le Mans production route. This fragment is staged as
# `/etc/caddy/lemans-prod.handlers.Caddyfile` and imported by the shared
# `delegateops.business` site block.

@lemans_prod_root path /prod/lemans
@lemans_prod path /prod/lemans /prod/lemans/*
redir @lemans_prod_root /prod/lemans/ 308

handle @lemans_prod {
	header {
		>Cache-Control "public, max-age=0, must-revalidate"
	}

	reverse_proxy lemans-prod-app:3000
}

# END LEMANS PROD ROUTE
