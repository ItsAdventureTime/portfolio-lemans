# BEGIN LEMANS DEMO ROUTE
# Le Mans remote demo route. This block is installed directly in the active
# `/home/jk/caddy/conf/Caddyfile` before the DelegateOps static fallback.

@lemans_demo path /lemans/demo /lemans/demo/*

handle @lemans_demo {
	header {
		>Cache-Control "public, max-age=0, must-revalidate"
	}

	reverse_proxy lemans-demo-app:3000
}

# END LEMANS DEMO ROUTE
