# BEGIN LEMANS DEMO ROUTE
# Le Mans remote demo route. This fragment is staged as
# `/etc/caddy/lemans-demo.handlers.Caddyfile` and imported by the shared
# `delegateops.business` site block.

@lemans_demo path /demo/lemans /demo/lemans/*

handle @lemans_demo {
	header {
		>Cache-Control "public, max-age=0, must-revalidate"
	}

	reverse_proxy lemans-demo-app:3000
}

# END LEMANS DEMO ROUTE
